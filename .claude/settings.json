{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "code-review-graph update --skip-flows",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      },
      {
        "hooks": [
          {
            "command": "git rev-parse --git-dir \u003e/dev/null 2\u003e\u00261 \u0026\u0026 code-review-graph update --skip-flows --repo \"/Users/logan/Developer/vibes/WORK/LIPLA/LPDGAN\" || true",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "code-review-graph status",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "git rev-parse --git-dir \u003e/dev/null 2\u003e\u00261 \u0026\u0026 code-review-graph status --repo \"/Users/logan/Developer/vibes/WORK/LIPLA/LPDGAN\" || echo 'Not a git repo, skipping'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python3.12)"
    ]
  }
}
